# ============================================================================
# Creatools Environment Variables
# Copy this file to .env and fill in the actual values
# ============================================================================

# Server
PORT=8080
NODE_ENV=production

# Database (PostgreSQL via RDS)
# Format: postgres://username:password@rds-endpoint:5432/database_name
DATABASE_URL=postgres://creatools_admin:YOUR_PASSWORD_HERE@creatools-db.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com:5432/creatools

# Authentication
JWT_SECRET=your-secure-jwt-secret-here-min-32-chars

# Stripe
# Get these from your Stripe Dashboard (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=REPLACE_WITH_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_YOUR_STRIPE_WEBHOOK_SECRET

# TikTools API
TIKTOOLS_API_KEY=your-tiktools-api-key-here

# Google Cloud Storage
GCS_PROJECT_ID=your-gcs-project-id
GCS_BUCKET_NAME=your-gcs-bucket-name
GOOGLE_APPLICATION_CREDENTIALS=/opt/creatools/app/gcs-credentials.json
