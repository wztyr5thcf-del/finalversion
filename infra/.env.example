# =============================================================================
# Creatools - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values before deploying.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Environment mode (production, development)
NODE_ENV=production

# Port the API server listens on (inside Docker container)
PORT=3000

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://creatools:YOUR_DB_PASSWORD@YOUR_RDS_ENDPOINT:5432/creatools

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Secret key for signing JWT tokens (use a strong random string, min 32 chars)
JWT_SECRET=your-super-secret-jwt-key-change-this

# -----------------------------------------------------------------------------
# URLs
# -----------------------------------------------------------------------------
# Frontend URL (used for CORS and redirects)
FRONTEND_URL=https://creatools.co

# Application URL (used in emails and webhooks)
APP_URL=https://creatools.co

# -----------------------------------------------------------------------------
# Stripe Payments
# -----------------------------------------------------------------------------
# Stripe secret key (starts with sk_live_ or sk_test_)
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (starts with whsec_)
STRIPE_WEBHOOK_SECRET=

# Stripe publishable key (starts with pk_live_ or pk_test_)
STRIPE_PUBLISHABLE_KEY=

# Stripe Price IDs for subscription plans
STRIPE_PRICE_ID_BASIC=
STRIPE_PRICE_ID_PRO=

# -----------------------------------------------------------------------------
# TikTok Integration
# -----------------------------------------------------------------------------
# TikTools API key for TikTok data
TIKTOOLS_API_KEY=

# TikTok developer app credentials
TIKTOK_CLIENT_KEY=

# TikTok OAuth redirect URI
TIKTOK_REDIRECT_URI=https://creatools.co/api/tiktok/callback

# -----------------------------------------------------------------------------
# Storage (Future - currently uses Replit Object Storage)
# -----------------------------------------------------------------------------
# When migrated to S3:
# AWS_S3_BUCKET=
# AWS_S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
